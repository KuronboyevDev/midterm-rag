# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

# --- OpenAI (chat + function calling) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- GitHub Issues (support ticket destination) ---
# Fine-grained or classic PAT with "repo" / "issues: write" scope.
GITHUB_TOKEN=ghp_your_github_token_here
# Repository that will receive support tickets, format: owner/repo  (no ".git" suffix)
GITHUB_REPO=your-username/support-tickets

# --- Behaviour flags ---
# When true, tickets are simulated (not actually sent to GitHub). Useful for local testing/demo.
TICKETS_DRY_RUN=false
